{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "dom"
    ],
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "importHelpers": true
  },
  "angularCompilerOptions": {
    "compilationMode": "partial",
    "strictInjectionParameters": true
  }
}
